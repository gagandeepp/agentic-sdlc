# Copy to .env for local development (.env is gitignored).
# MongoDB Atlas connection string, used by `docker compose` and by a locally run API.
# Atlas Network Access must allow this machine's IP.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=agentic_sdlc
ENABLE_DEV_ROUTES=true

# Agents (Plan 2). The API reads these from this file; agent processes never see them.
# AGENT_ANTHROPIC_KEY=sk-ant-...
# Fine-grained PAT for the sandbox repo only: Contents RW, Pull requests RW, Checks R, Commit statuses R.
# AGENT_GITHUB_TOKEN=github_pat_...

# Outside Docker there is no separate agent user, so roles with Bash (Dev, Reviewer, QA, DevOps)
# refuse to run. Set this only on a machine you trust, to accept that risk in local development.
# ALLOW_UNISOLATED_BASH=true

# Orchestrator (Plan 3). Live runs target this repo unless the GUI form says otherwise.
# DEFAULT_REPO=gagandeepp/agentic-sdlc-sandbox
